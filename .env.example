# ---------------------------------------------------------------- OpenAI
OPENAI_API_KEY=sk-sua-chave-aqui
# Modelo de chat usado para classificar e gerar dicas
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Modelo de embedding (não troque depois de indexar sem reindexar do zero)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------- Segurança
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres
JWT_EXPIRE_MINUTES=60

# Administrador criado na primeira execução (depois pode ser alterado via API)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha-min-12-caracteres

DATABASE_PATH=data/users.db
DEFAULT_RATE_LIMIT_PER_HOUR=120
TAMANHO_MAX_REQUISICAO_KB=256

# ---------------------------------------------------------------- Armazenamento
CHROMA_PATH=data/chroma
EXPORTS_PATH=data/exports
CHROMA_COLLECTION=chamados

# ---------------------------------------------------------------- Recuperação
TOP_K_DEFAULT=6
TOP_K_MAX=15
IGNORAR_STATUS=Cancelado,Rejeitado

# ---------------------------------------------------------------- API
HOST=0.0.0.0
PORT=8000

# Em produção troque os três abaixo. Com PRODUCAO=true a API recusa subir se
# CORS_ORIGINS ou ALLOWED_HOSTS estiverem como "*", ou se os segredos forem fracos.
PRODUCAO=false
CORS_ORIGINS=*
ALLOWED_HOSTS=*

# /docs e /redoc (desligue em produção se a API for pública)
DOCS_HABILITADO=true
# tela de testes em "/" (exige login quando ligada)
TELA_HABILITADA=true

# ---------------------------------------------------------------- WhatsApp (Evolution API)
# Bot que deixa o cliente consultar o próprio chamado. Só telefones cadastrados
# (POST /whatsapp/contatos) recebem dados. Deixe desligado até ter a Evolution configurada.
WHATSAPP_HABILITADO=false
EVOLUTION_URL=https://evolution.seudominio.com.br
EVOLUTION_INSTANCE=nome-da-instancia
EVOLUTION_API_KEY=apikey-da-instancia
# Segredo que vai na URL do webhook. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# e configure no Evolution: https://SUA-API/whatsapp/webhook/<este-token>
WHATSAPP_WEBHOOK_TOKEN=
WHATSAPP_MSGS_POR_10MIN=20
WHATSAPP_MAX_LISTA=5
# Reescreve a resposta em linguagem simples com o modelo (custo por consulta)
WHATSAPP_RESUMO_IA=false

# ---------------------------------------------------------------- RPA de raspagem
LECOM_URL=https://bpm.nexum.com.br/workspace/
# LECOM_PERFIL=data/chrome-profile
# LECOM_PERFIL_NOME=Default
